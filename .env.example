# Project New Horizon — Environment Variables
# Copy this file to .env and fill in your actual API keys.
# .env is git-ignored and never committed.

# Groq Whisper transcription keys (at least one required)
GROQ_WHISPER_KEY_1=gsk_your_key_here
GROQ_WHISPER_KEY_2=gsk_optional_second_key
GROQ_WHISPER_KEY_3=gsk_optional_third_key

# Groq GPT-OSS 120B answer keys (Phase 3)
GROQ_ANSWER_KEY_1=gsk_your_key_here
GROQ_ANSWER_KEY_2=gsk_optional_second_key
GROQ_ANSWER_KEY_3=gsk_optional_third_key
